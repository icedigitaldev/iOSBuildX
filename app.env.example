# Copia esto a app.env y rellénalo. app.env no va al repo.

# La app
APP=/root/MiApp                      # dónde vive el proyecto dentro de la VM
NAME=MiApp                           # nombre visible
BUNDLE=com.ejemplo.miapp
FLUTTER=3.47.4                       # la versión con la que compilas
MIN_OS=15.0                          # iOS mínimo; Apple exige 15.0 desde 2027

# Cuenta de Apple. Los ids salen de appstoreconnect.apple.com
TEAM_ID=XXXXXXXXXX                   # Membership > Team ID
CERT_ID=XXXXXXXXXX                   # Certificates > el de distribución
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000   # Users and Access > Integrations
ASC_KEY_ID=XXXXXXXXXX                # la API key de esa misma página

# En signing/ tienen que estar: dist.key, dist.cer, el perfil y la API key .p8
PROFILE=perfil.mobileprovision
ASC_KEY=AuthKey_XXXXXXXXXX.p8
